    "meaning": "每天檢查來源是否更新；來源未變時不重算、不覆寫已發布資料。"
  },
  "displayWindow": {
    "calendar": "ROC",
    "startFormula": "currentRocYear - 5",
    "endFormula": "currentRocYear - 1",
    "exampleCurrentRoc115": [110, 111, 112, 113, 114],
    "exampleCurrentRoc116": [111, 112, 113, 114, 115]
  },
  "defaultDashboardView": "同年度檢視",
  "sources": [
    {
      "sourceAlias": "MOI-POP1Y",
      "nativeRefreshCadence": "每月",
      "dailyReviewAction": "檢查最新已發布月份、分頁筆數、來源期間與SHA-256；年度圖使用各年12月31日快照。"
    },
    {
      "sourceAlias": "MOI-EDU5Y",
      "nativeRefreshCadence": "每年",
