    },
    {
      "sourceAlias": "MOI-MARITAL5Y",
      "nativeRefreshCadence": "每年",
      "dailyReviewAction": "檢查年度ZIP之Last-Modified、檔案大小及SHA-256；來源未變時不重跑PCLM/IPF。"
    },
    {
      "sourceAlias": "DGBAS-NTPC-LABOR-ANNUAL",
      "nativeRefreshCadence": "每年",
      "dailyReviewAction": "檢查統計年報頁與各表檔案雜湊；新年度完整表組到齊後才重算。"
    },
    {
      "sourceAlias": "STAT-WAGE-LOC",
      "nativeRefreshCadence": "每年",
      "dailyReviewAction": "檢查官方表6工作簿的資料年度與雜湊；網頁更新日不得冒充資料年度。"
    },
    {
      "sourceAlias": "NTPC-OPENAPI-CROSSCHECK",
      "nativeRefreshCadence": "依資料集",
      "dailyReviewAction": "每日檢查命題指定新北市OpenAPI資料集之schema、最新資料期及分頁完整性，作交叉驗證而非混接母體。"
    },
    {
      "sourceAlias": "NTPC-OAS-CROSSCHECK",
      "nativeRefreshCadence": "依統計表",
      "dailyReviewAction": "每日檢查命題指定新北市統計資料庫是否發布新年度，保留人工匯出或鏡像查核證據。"
    },
    {
      "sourceAlias": "NTPC-LAND-AREA",
      "nativeRefreshCadence": "不定期修訂",
      "dailyReviewAction": "每日檢查資料集頁與CSV API之schema、29區唯一性、公告面積合計及SHA-256；面積修訂時重算所有受影響年度密度。"
    },
    {
      "sourceAlias": "NTPC-YOUTH-ANNUAL",
      "nativeRefreshCadence": "每年",
      "dailyReviewAction": "每日檢查青年局統計年報索引是否新增年度或修訂檔；新檔先驗證場次、人次、性別加總及分類可比性。"
    },
    {
      "sourceAlias": "NTPC-YOUTH-CAREER-BASE-113",
      "nativeRefreshCadence": "依專案報告",
      "dailyReviewAction": "檢查是否發布新版青職基地分析或可拆出35歲之年齡表；未取得前18–35歲維持邊界範圍，不發布點估計。"
    },
    {
      "sourceAlias": "NTPC-YOUTH-BASE-PAGES",
      "nativeRefreshCadence": "不定期",
      "dailyReviewAction": "每日檢查據點清冊、地址、營運狀態及公開量能欄位；內容變更時保存新HTML快照並重建據點清冊。"
    }
  ],
  "changeDetection": {
    "preferred": ["ETag", "Last-Modified", "Content-Length", "SHA-256"],
    "unchangedStatus": "NO_CHANGE",
    "changedStatus": "SOURCE_CHANGED_PENDING_QA",
    "rules": [
      "未變更：只寫審視日誌，不建立新發布版本。",
      "已變更：保存不可變原始快照，執行schema、列數、期間、範圍與公式驗證。",
      "驗證通過：產生三母體CSV及政策服務輔助CSV候選版本；人工查核通過後原子式切換資料目錄。",
      "驗證失敗：移入quarantine，舊版CSV繼續服務，ChatBot必須回報資料仍在查核。"
    ]
  },
  "publicationFiles": [
