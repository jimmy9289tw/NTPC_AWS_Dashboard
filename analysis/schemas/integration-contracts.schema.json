{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/integration-contracts.schema.json",
  "type": "object",
  "required": ["contractVersion", "defaultPolicy", "sources"],
  "properties": {
    "contractVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "defaultPolicy": {
      "type": "object",
      "required": ["timeoutSeconds", "maxAttempts", "hashAlgorithm", "failClosed"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "connector", "grain", "refreshCadence", "use", "limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
          "connector": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"enum": ["http_json", "http_json_paginated", "http_xlsx", "manual_export", "ocr_optional"]}
            }
          }
        }
      }
    }
  }
}
