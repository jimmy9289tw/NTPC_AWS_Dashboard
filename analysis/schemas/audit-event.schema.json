{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.ntpc.gov.tw/schemas/audit-event.schema.json",
  "title": "NTPC Youth AI Audit Event",
  "type": "object",
  "required": ["schemaVersion", "eventType", "actor", "observedAt", "sourceIds", "input", "output", "sha256"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eventType": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "observedAt": {"type": "string", "format": "date-time"},
    "sourceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "input": {"type": "object"},
    "output": {"type": "object"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
