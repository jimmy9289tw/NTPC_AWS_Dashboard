{
  "name": "ntpc-youth-evidence-dashboard",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.aws.config.mts --configLoader runner --mode public",
    "build": "vite build --config vite.aws.config.mts --configLoader runner --mode public && vite build --config vite.aws.config.mts --configLoader runner --mode internal",
    "start": "vite preview --config vite.aws.config.mts --mode public",
    "test": "node --import ./tests/aws-runtime-setup.mjs --import tsx --test tests/aws-roa.test.mts tests/aws-region-map.test.mts tests/chart-transition.test.mts tests/data-reading.test.mts tests/wage-metrics.test.mjs",
    "legacy:build": "vinext build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "types:worker": "wrangler types worker/worker-configuration.d.ts --config wrangler.production.jsonc",
    "check:worker": "tsc --noEmit -p tsconfig.worker.json",
    "data:mol-salary": "node scripts/build-mol-salary-context.mjs",
    "data:youth-industry-wage": "python scripts/build-youth-industry-wage.py",
    "data:policy-ranking": "node scripts/build-policy-ranking-csv.mjs",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --config wrangler.production.jsonc --outdir dist/deploy-dry-run",
    "deploy": "npm run build && python ../deploy.py upload",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
